# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า (ไฟล์ .env อยู่ใน .gitignore จะไม่ถูกอัปโหลด)

# --- Django ---
# สร้างคีย์ลับ: py -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1

# --- การเทียบใบหน้า (ค่าน้อย = เข้มงวดกว่า) ---
FACE_MATCH_THRESHOLD=0.5

# --- Google Sheet (เว้นว่างไว้ได้ ระบบจะทำงานปกติแต่ยังไม่ส่งขึ้นชีต) ---
# ID ของชีต: ข้อความยาว ๆ ใน URL ระหว่าง /d/ กับ /edit
GOOGLE_SHEET_ID=1reTa4K8YzjGgLDf_Et97gUufM5kl9tOND0_zRRn94UE
# ชื่อแท็บ (เว้นว่าง = แท็บแรก)
GOOGLE_SHEET_WORKSHEET=
# พาธไฟล์ key ของ Service Account — เก็บไว้ "นอก" โฟลเดอร์โปรเจ็คนี้ เช่น
# GOOGLE_SERVICE_ACCOUNT_FILE=C:/Users/ชื่อคุณ/secrets/face-login-sa.json
GOOGLE_SERVICE_ACCOUNT_FILE=C:/Users/Lenovo/secrets/face-login-sa.json
